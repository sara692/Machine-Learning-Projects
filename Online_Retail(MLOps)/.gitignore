# data is tracked by DVC, not git (DVC adds the exact .gitignore entries for its outputs)
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
reports/drift.json
models/*
!models/.gitkeep
.env

# deployment artifacts and secrets
deploy/model/
.env.*
